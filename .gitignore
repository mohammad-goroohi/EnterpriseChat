# ============================================
# EnterpriseChat - .gitignore
# .NET MAUI + Blazor Hybrid + ASP.NET Core
# ============================================

# --------------------------------------------
# Visual Studio
# --------------------------------------------

.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Rider / JetBrains
.idea/
*.sln.iml

# --------------------------------------------
# Build output
# --------------------------------------------

[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
ARM/
ARM64/

# Generated build artifacts
*.dll
*.exe
*.pdb
*.cache
*.ilk
*.tmp
*.log

# --------------------------------------------
# .NET
# --------------------------------------------

project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# NuGet generated files
**/obj/project.assets.json
**/obj/project.nuget.cache
**/obj/*.nuget.g.props
**/obj/*.nuget.g.targets

# --------------------------------------------
# .NET MAUI
# --------------------------------------------

# Android
**/Platforms/Android/bin/
**/Platforms/Android/obj/

# iOS
**/Platforms/iOS/bin/
**/Platforms/iOS/obj/

# MacCatalyst
**/Platforms/MacCatalyst/bin/
**/Platforms/MacCatalyst/obj/

# Windows
**/Platforms/Windows/bin/
**/Platforms/Windows/obj/

# Tizen
**/Platforms/Tizen/bin/
**/Platforms/Tizen/obj/

# MAUI generated files
**/MauiProgram.g.cs
**/Resources/Fonts/*.ttf
**/Resources/Fonts/*.otf

# Android generated files
*.apk
*.aab
*.keystore
*.jks

# Android build/cache
**/.gradle/
**/build/
**/.cxx/

# --------------------------------------------
# Blazor
# --------------------------------------------

# Blazor generated/static build output
**/wwwroot/_framework/
**/wwwroot/_content/

# --------------------------------------------
# ASP.NET Core
# --------------------------------------------

# Local development certificates
*.pfx
*.cer

# ASP.NET Core HTTPS development certificate
aspnetcore-https.pfx

# --------------------------------------------
# Entity Framework Core
# --------------------------------------------

# EF generated migration bundles
*.efbundle

# --------------------------------------------
# Configuration / Secrets
# --------------------------------------------

# Local configuration
appsettings.Local.json
appsettings.Development.Local.json

# User-specific secrets
secrets.json

# Environment files
.env
.env.*
!.env.example

# --------------------------------------------
# Logs
# --------------------------------------------

logs/
*.log

# --------------------------------------------
# Databases / Local data
# --------------------------------------------

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local SQL Server database files
*.mdf
*.ndf
*.ldf

# --------------------------------------------
# Test results
# --------------------------------------------

TestResults/
*.trx
*.coverage
*.coveragexml
coverage/
coverage-report/

# --------------------------------------------
# Code coverage
# --------------------------------------------

.coverage
.coverage.*
*.opencover.xml

# --------------------------------------------
# Documentation generated output
# --------------------------------------------

docs/_site/
docs/build/

# --------------------------------------------
# Temporary files
# --------------------------------------------

*.bak
*.backup
*.old
*.orig
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --------------------------------------------
# OS files
# --------------------------------------------

# Windows
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# --------------------------------------------
# Publish output
# --------------------------------------------

publish/
Publish/
**/publish/
**/Publish/

# --------------------------------------------
# Docker
# --------------------------------------------

# Local Docker override files
docker-compose.override.yml

# Docker local data
.docker/

# --------------------------------------------
# Local development tools
# --------------------------------------------

*.local

# --------------------------------------------
# Certificates / Signing
# --------------------------------------------

# Never commit signing certificates or private keys
*.key
*.pem
*.p12
*.pfx

# --------------------------------------------
# MAUI / Android signing
# --------------------------------------------

# Android signing configuration
keystore.properties

# --------------------------------------------
# Rider / ReSharper
# --------------------------------------------

_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# --------------------------------------------
# MSBuild
# --------------------------------------------

*.binlog
msbuild.binlog

# --------------------------------------------
# Temporary solution/project files
# --------------------------------------------

*.pidb
*.svclog
*.userprefs

# --------------------------------------------
# Local development folders
# --------------------------------------------

.local/
.localdata/
temp/
tmp/

# --------------------------------------------
# Keep important example configuration files
# --------------------------------------------

!.env.example
!appsettings.example.json
!appsettings.Development.example.json
!keystore.properties.example
