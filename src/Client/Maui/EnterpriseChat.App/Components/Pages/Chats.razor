@page "/"
@page "/chats"
@inject NavigationManager Navigation
<div class="chat-page">

    <!-- Header -->
    <div class="chat-header">
        <div class="container-fluid px-0">
            <div class="d-flex align-items-center justify-content-between">

                <div>
                    <h5 class="mb-0 fw-semibold">Chats</h5>
                    <small class="text-muted">@ChatsItems.Count chats</small>
                </div>

                <!-- New Chat -->
                <button class="btn btn-primary rounded-circle new-chat-btn"
                        title="New Chat">
                    <i class="fa-solid fa-plus"></i>
                </button>

            </div>
        </div>
    </div>


    <!-- Search -->
    <div class="chat-search">
        <div class="input-group">

            <span class="input-group-text">
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>

            <input type="text"
                   class="form-control"
                   placeholder="Search chats..."
                   @bind="SearchText"
                   @bind:event="oninput" />

        </div>
    </div>


    <!-- Chat List -->
    <div class="chat-list">

        @foreach (var chat in FilteredChats)
        {
            <div class="chat-item"
                 @onclick="() => OpenChat(chat)">

                <!-- Avatar -->
                <div class="chat-avatar-wrapper">

                    <img src="@chat.Avatar"
                         class="chat-avatar"
                         alt="@chat.Name" />

                    @if (chat.IsOnline)
                    {
                        <span class="online-dot"></span>
                    }

                </div>


                <!-- Chat Content -->
                <div class="chat-content">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="chat-name">
                            @chat.Name
                        </div>

                        <div class="chat-time">
                            @chat.LastMessageTime
                        </div>

                    </div>


                    <div class="d-flex justify-content-between align-items-center">

                        <div class="chat-last-message">

                            @if (chat.IsTyping)
                            {
                                <span class="typing-text">
                                    typing...
                                </span>
                            }
                            else
                            {
                                @chat.LastMessage
                            }

                        </div>


                        @if (chat.UnreadCount > 0)
                        {
                            <span class="unread-badge">
                                @(chat.UnreadCount > 99
                                                        ? "99+"
                                                        : chat.UnreadCount.ToString())
                    </span>
                                        }

                    </div>

                </div>

            </div>
        }

        @if (!FilteredChats.Any())
        {
            <div class="empty-search">

                <i class="fa-solid fa-comments"></i>

                <div class="mt-3 fw-semibold">
                    No chats found
                </div>

                <small class="text-muted">
                    Try searching for another user
                </small>

            </div>
        }

    </div>

</div>


